# Normalise line endings to LF in the repository (the project is developed on Windows, runs in Linux containers).
* text=auto eol=lf

*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.ico  binary
*.jar  binary
*.woff binary
*.woff2 binary
