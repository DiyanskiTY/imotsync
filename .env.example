# Copy to .env (git-ignored). Read by docker compose and by the API and the worker when they run
# locally. The Docker API and worker containers get only the variables docker-compose.yml passes
# to them.
NODE_ENV=development

# --- API ---
API_PORT=3000
CORS_ORIGIN=http://localhost:4200
# Optional, only behind a reverse proxy, so the login rate limit sees each client's IP instead
# of the proxy's. false (default): no proxy. A number: exactly how many proxies stand in front
# of the API (usually 1). Or their addresses, subnets or presets, comma-separated (e.g.
# loopback, uniquelocal or 10.0.0.0/8).
# Never true: it trusts every hop, so clients could fake their IP in X-Forwarded-For; the API
# refuses true and does not start when NODE_ENV=production.
# TRUST_PROXY=false
# Used for signing login tokens. Must be at least 32 characters when NODE_ENV=production.
# This placeholder is public and only meant for local development. The Docker API container
# never uses an empty value or one starting with dev-only: it generates a random secret at each
# start instead.
# For tokens that survive a restart, set a random value of your own, e.g. the output of
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-change-me-to-a-long-random-value
# Optional: lifetime of a login token in seconds, 60 to 2592000 (30 days); default 28800 = 8 hours.
# JWT_TTL_SECONDS=28800
# Where uploaded and generated photos are stored. Relative paths resolve from the api/ folder.
UPLOAD_DIR=./uploads

# --- Database (MariaDB in Docker) ---
# Host port 3307 avoids clashing with a local MariaDB/MySQL on 3306.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=imotsync
DB_USER=imotsync
DB_PASSWORD=imotsync_dev
DB_ROOT_PASSWORD=root_dev

# --- Public demo ---
# Optional: true runs the public demo (README, Public demo): the "Try the demo" sign-in, the banner,
# lower upload and request limits, and closed feeds. Refuses a REALISTIMO_API_KEY.
# DEMO_MODE=false

# --- Demo seed ---
# Password given to the seeded demo accounts (admin@imotsync.local, broker@imotsync.local).
SEED_DEMO_PASSWORD=demo1234

# --- Publishing: feeds (Docker replaces an empty or dev-only FEED_TOKEN at each start) ---
# The API's public origin, no trailing slash; feed and photo URLs start with it (HTTPS for portals).
# NODE_ENV=production requires a public https:// origin (not localhost or 127.0.0.1).
# Stored feed entries keep the photo URLs they were built with: after a change, publish the live
# properties again (README, Feeds).
PUBLIC_BASE_URL=http://localhost:3000
# Optional: true lets NODE_ENV=production run with an http:// or local PUBLIC_BASE_URL; only for a
# local run of the production build (the Docker Compose stack, CI), never for a public server.
# ALLOW_INSECURE_PUBLIC_BASE_URL=false
# Secret part of the feed URLs; this one is public (production: 32+ chars, not starting dev-only).
# The worker does not read FEED_TOKEN or JWT_SECRET.
FEED_TOKEN=dev-only-feed-token
# Optional: the agency's page per listing for the Bazar.bg feed, {refCode} replaced; empty = none.
# PUBLIC_LISTING_URL_TEMPLATE=https://agency.example/properties/{refCode}

# --- Publishing: worker ---
# Optional: jobs one worker runs at a time, 1 to 16 (default 2).
# WORKER_CONCURRENCY=2
# Optional: how often an idle worker looks for due jobs, 100 to 60000 ms (default 1000).
# WORKER_POLL_INTERVAL_MS=1000
# Optional: time budget for one portal call, 1 to 3600 seconds (default 60).
# JOB_TIMEOUT_SECONDS=60
# Optional: a job running longer than this (seconds) is abandoned; at least JOB_TIMEOUT_SECONDS + 60.
# JOB_LOCK_TIMEOUT_SECONDS=300
# Optional: retry back-off base, random(0.5, 1) * min(cap, base * 2^(attempts - 1)) seconds.
# RETRY_BASE_SECONDS=30
# Optional: longest retry delay in seconds, not below RETRY_BASE_SECONDS (default 3600).
# RETRY_CAP_SECONDS=3600

# --- Publishing: demo portal (in-process fake, no network) ---
# Share of demo portal calls that fail, 0 to 1 (0 = always succeed, 1 = always fail).
DEMO_PORTAL_FAILURE_RATE=0.3
# Optional: simulated duration of a demo portal call, 0 to 60000 ms (default 400).
# DEMO_PORTAL_LATENCY_MS=400

# --- Publishing: Realistimo ---
# Optional: the agency's id in Realistimo (agency_uid), set at onboarding; default is a placeholder.
# REALISTIMO_AGENCY_UID=imotsync-demo
# Optional: API key from Realistimo; empty (the default) keeps the worker's import sync off.
# Docker passes it to the worker container only.
# REALISTIMO_API_KEY=
# Optional: origin of Realistimo's REST API, no path (default https://realistimo.com); https in production.
# REALISTIMO_API_BASE_URL=https://realistimo.com
# Optional: seconds between the worker's Realistimo sync cycles, 60 to 86400 (default 900).
# REALISTIMO_SYNC_INTERVAL_SECONDS=900

# --- Publishing: Bazar.bg ---
# Optional: days a removed listing stays in the Bazar feed as out of stock, 1 to 365 (default 30).
# A deleted property whose removal is still served is kept (archived) until then.
# BAZAR_REMOVED_RETENTION_DAYS=30
