# Copy to .env (git-ignored). Read by docker compose and by the API when it runs locally.
NODE_ENV=development

# --- API ---
API_PORT=3000
CORS_ORIGIN=http://localhost:4200
# Used for signing login tokens. Must be at least 32 characters when NODE_ENV=production.
# This placeholder is public and only meant for local development. The Docker API container
# never uses an empty value or one starting with dev-only: it generates a random secret at each
# start instead.
# For tokens that survive a restart, set a random value of your own, e.g. the output of
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-change-me-to-a-long-random-value
# Where uploaded and generated photos are stored. Relative paths resolve from the api/ folder.
UPLOAD_DIR=./uploads

# --- Database (MariaDB in Docker) ---
# Host port 3307 avoids clashing with a local MariaDB/MySQL on 3306.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=imotsync
DB_USER=imotsync
DB_PASSWORD=imotsync_dev
DB_ROOT_PASSWORD=root_dev

# --- Demo seed ---
# Password given to the seeded demo accounts (admin@imotsync.local, broker@imotsync.local).
SEED_DEMO_PASSWORD=demo1234
