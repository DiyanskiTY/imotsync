# Production settings for deploy/compose.yml. Copy to deploy/.env (git-ignored) on the server and
# fill in every empty value. Generate each secret with:
#   openssl rand -hex 32
# Never commit the filled-in file.

# --- Address ---
# The host name Caddy gets an HTTPS certificate for (its DNS record must point at this server).
SITE_ADDRESS=imotsync.palovtech.com
# The public origin: the admin panel, the API and the photo URLs all use it.
PUBLIC_BASE_URL=https://imotsync.palovtech.com

# --- Public demo ---
# true: the "Try the demo" button, the banner, lower limits, closed feeds and the nightly reset.
DEMO_MODE=true

# --- Secrets (required) ---
# Signs login tokens (at least 32 characters).
JWT_SECRET=
# The feed URL token; required in production even though the demo's feeds are closed.
FEED_TOKEN=
# The application's database user, and MariaDB's root user (used by backup-db.sh).
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Password of the two seeded accounts. Visitors use the demo button and never need it; keep it
# secret so that only you can sign in as admin@imotsync.local.
SEED_DEMO_PASSWORD=

# --- Optional ---
# DB_NAME=imotsync
# DB_USER=imotsync
# WORKER_CONCURRENCY=2
# Share of demo portal calls that fail on purpose, so visitors see retries (0 to 1).
# DEMO_PORTAL_FAILURE_RATE=0.3
# Retry delays of the publishing jobs, in seconds (short for the demo).
# RETRY_BASE_SECONDS=10
# RETRY_CAP_SECONDS=120
# Largest request body Caddy passes to the API, in bytes (default 31457280 = 30 MB, above the
# demo's 5 photos of 5 MB). Without DEMO_MODE the API accepts 20 photos of 15 MB: set 325058560.
# MAX_REQUEST_BODY_BYTES=31457280
# Host ports (only for a local run of this stack next to other servers).
# HTTP_PORT=80
# HTTPS_PORT=443
# Only for a local run over plain HTTP (SITE_ADDRESS=:80, PUBLIC_BASE_URL=http://localhost...).
# ALLOW_INSECURE_PUBLIC_BASE_URL=false
